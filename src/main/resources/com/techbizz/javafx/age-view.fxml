<?import javafx.geometry.Insets?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.ScrollPane?>
<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.techbizz.javafx.AgeController"
            fitToWidth="true"
            hbarPolicy="NEVER"
>

    <VBox spacing="15"
          alignment="CENTER_LEFT">


        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
        </padding>

        <Label text="Enter Your Date and Time of Birth"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <VBox spacing="5">
            <Label text="Date of Birth"/>

            <DatePicker fx:id="birthDatePicker"
                        promptText="Select date of birth"
                        maxWidth="Infinity"/>
        </VBox>

        <!-- Time of Birth -->
        <VBox spacing="5">
            <Label text="Time of Birth"/>

            <HBox spacing="10">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Hour (0–23)"/>
                    <Spinner fx:id="hourSpinner"
                             maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Minute (0–59)"/>
                    <Spinner fx:id="minuteSpinner"
                             maxWidth="Infinity"/>
                </VBox>
            </HBox>
        </VBox>
        <Button fx:id="calculateAge"
                text="Calculate Age."
                onAction="#calculateAge"
                maxWidth="Infinity"
                defaultButton="true"/>

        <Label fx:id="ageLabel" wrapText="true"/>
        <Hyperlink fx:id="goToHome" onAction="#onGoHome" text="Go Home."/>
    </VBox>
</ScrollPane>